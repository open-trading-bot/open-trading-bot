# Bot mode: live | paper
BOT_MODE=paper

# Bybit API credentials
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Use Bybit testnet (true for paper trading with real API)
BYBIT_TESTNET=true

# Server
PORT=3001
API_KEY=change-me-to-a-random-string
JWT_SECRET=change-me-to-a-random-jwt-secret
# Key that encrypts the exchange API keys of the users in the database.
# Make the key with: openssl rand -hex 32
# Keep a backup of the key. If you lose the key, the users must add their exchange API keys again.
EXCHANGE_KEYS_ENC_KEY=change-me-run-openssl-rand-hex-32
# Optional. Set the old EXCHANGE_KEYS_ENC_KEY here during a key rotation.
EXCHANGE_KEYS_ENC_KEY_PREVIOUS=
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-strong-password
# true creates the demo users demo/demo and user/user. Use only for local tests.
SEED_DEMO_USERS=false

# Trading defaults
TRADE_AMOUNT=100
STOP_LOSS_PCT=2
DAILY_LOSS_LIMIT=500
MAX_OPEN_POSITIONS=10

# Email (Resend) — required for sending invitations
RESEND_API_KEY=
EMAIL_FROM="Trading Bot <noreply@yourdomain.com>"
# Base URL of the dashboard. Invitation links use it.
# When it is set, the reCAPTCHA response must show the same host name.
# With Docker, use https://<DOMAIN>.
PUBLIC_APP_URL=https://localhost

# reCAPTCHA for the interest form. In production (NODE_ENV=production, the
# default in the Docker images) the form refuses submissions without it.
RECAPTCHA_SECRET_KEY=

# Docker: host names for HTTPS. Caddy gets the certificates automatically.
# Point the DNS records of both names to the server.
# Keep localhost to run on your computer. Caddy then uses a local certificate.
DOMAIN=localhost
BACKOFFICE_DOMAIN=admin.localhost

# Optional. IP addresses and CIDR ranges that can use the backoffice.
# Separate the values with spaces. Other addresses get HTTP 403.
# Do not set an empty value: Caddy then blocks all addresses.
# BACKOFFICE_ALLOWED_IPS=203.0.113.7 10.0.0.0/8
