# Bot mode: live | paper
BOT_MODE=paper

# Bybit API credentials
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Use Bybit testnet (true for paper trading with real API)
BYBIT_TESTNET=true

# Server
PORT=3001
API_KEY=change-me-to-a-random-string
JWT_SECRET=change-me-to-a-random-jwt-secret
# Key that encrypts the exchange API keys of the users in the database.
# Make the key with: openssl rand -hex 32
# Keep a backup of the key. If you lose the key, the users must add their exchange API keys again.
EXCHANGE_KEYS_ENC_KEY=change-me-run-openssl-rand-hex-32
# Optional. Set the old EXCHANGE_KEYS_ENC_KEY here during a key rotation.
EXCHANGE_KEYS_ENC_KEY_PREVIOUS=
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-strong-password
# true creates the demo users demo/demo and user/user. Use only for local tests.
SEED_DEMO_USERS=false

# Trading defaults
TRADE_AMOUNT=100
STOP_LOSS_PCT=2
DAILY_LOSS_LIMIT=500
MAX_OPEN_POSITIONS=10

# Email (Resend) — required for sending invitations
RESEND_API_KEY=
EMAIL_FROM="Trading Bot <noreply@yourdomain.com>"
# Base URL of the main client app used to build invitation accept links
PUBLIC_APP_URL=http://localhost:5173
